{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "design-preview",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8899"
      ],
      "port": 8899
    },
    {
      "name": "maxitor-api",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--extra",
        "dev",
        "uvicorn",
        "maxitor.viewer.api.app:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "maxitor-client",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "packages/maxitor/app/client"
      ],
      "port": 5173
    }
  ]
}
