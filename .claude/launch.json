{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "design-preview",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8899"
      ],
      "port": 8899
    },
    {
      "name": "maxitor",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--extra",
        "dev",
        "uvicorn",
        "maxitor.front.api.app:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "repo-graph-port-demo",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "MAXITOR_HISTORIES=/Users/bystrovmaxim/PythonDev/aoa/.demo-history/histories.toml",
        "MAXITOR_HISTORY_CACHE=/Users/bystrovmaxim/PythonDev/aoa/.demo-history/cache",
        "REPO_GRAPH_PORT_PORT=8102",
        "uv",
        "run",
        "repo-graph-port"
      ],
      "port": 8102
    },
    {
      "name": "maxitor-client",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "packages/maxitor/front/client"
      ],
      "port": 5173
    }
  ]
}
