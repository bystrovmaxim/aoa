# deploy/stand/.env.example — named configuration for the demonstrator stand.
#
# Real values live in /etc/aoa-stand.env on the host and never enter the
# repository. Copy this file there and fill in what the host requires.

# Internal port of the demonstrator container (published on 127.0.0.1 only).
DEMO_PORT=8100

# Internal port of the Maxitor container (published on 127.0.0.1 only).
# 8101 is occupied by the pre-existing maxitor.aoa.run stand — the dev stand uses 8102.
MAXITOR_PORT=8102

# Port of the repo-graph-port container on the host (published on 127.0.0.1 only;
# the container itself listens on 8102). 8103: 8101 and 8102 are taken above.
REPO_GRAPH_PORT_PORT=8103

# The folder on the host with the port's histories.toml (writable: key commands write
# into it) and secrets.env (GITHUB_APP_PRIVATE_KEY, GITHUB_WEBHOOK_SECRET).
REPO_GRAPH_PORT_CONFIG_DIR=/etc/aoa-repo-graph-port

# The stand domains, served over HTTPS by the host's existing TLS front end.
DEMO_DOMAIN=dev.demo.aoa.run
MAXITOR_DOMAIN=dev.maxitor.aoa.run
REPO_GRAPH_PORT_DOMAIN=repo-graph-port.aoa.run

# The host that runs the stand.
HOST=194.67.66.48

# SSH alias used to reach the host (either existing key works: up2y-prod / digtwin-prod).
SSH_ALIAS=
