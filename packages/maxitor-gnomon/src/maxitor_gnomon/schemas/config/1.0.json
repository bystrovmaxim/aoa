{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bystrovmaxim/aoa/blob/main/packages/maxitor-gnomon/src/maxitor_gnomon/schemas/config/1.0.json",
  "title": "Gnomon config",
  "description": "gnomon.toml: the graphs of one repository, each built by a command and saved in a file.",
  "type": "object",
  "additionalProperties": false,
  "required": ["gnomon", "graph"],
  "properties": {
    "gnomon": {
      "const": "1.0"
    },
    "graph": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "build", "file"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "cwd": {"type": "string", "minLength": 1},
          "build": {"type": "string", "minLength": 1},
          "file": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
