                },
                "classifier_field": {
                  "type": "string",
                  "minLength": 1,
                  "description": "The field whose value selects among the alternatives; absent on an axis classified by a dictionary, because the head has no classifier field."
                },
                "dictionary_qualname": {
                  "type": "string",
                  "minLength": 1,
