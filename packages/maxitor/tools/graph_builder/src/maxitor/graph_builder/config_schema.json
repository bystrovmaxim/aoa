{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/bystrovmaxim/aoa/main/packages/maxitor/tools/graph_builder/src/maxitor/graph_builder/config_schema.json",
  "title": "graph-builder config",
  "description": "graph-builder.toml: the graphs of one repository, each built by a command and saved in a file.",
  "type": "object",
  "additionalProperties": false,
  "required": ["graph_builder", "graph"],
  "properties": {
    "graph_builder": {
      "const": "1.0"
    },
    "setup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skill",
        "decided",
        "deferred"
      ],
      "description": "Wizard decisions, not evidence of current health or a project release version.",
      "properties": {
        "skill": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "decided": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(config|local-update|ci-graph-check|version-tags|graph:.+|exporter:.+)$"
          }
        },
        "deferred": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "local-update",
              "ci-graph-check"
            ]
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "deferred": {
                "contains": {
                  "const": "local-update"
                }
              }
            }
          },
          "then": {
            "properties": {
              "decided": {
                "contains": {
                  "const": "local-update"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "deferred": {
                "contains": {
                  "const": "ci-graph-check"
                }
              }
            }
          },
          "then": {
            "properties": {
              "decided": {
                "contains": {
                  "const": "ci-graph-check"
                }
              }
            }
          }
        }
      ]
    },
    "graph": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "build", "file"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "cwd": {"type": "string", "minLength": 1},
          "build": {"type": "string", "minLength": 1},
          "file": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
